#!/usr/bin/env python3
import argparse
import os
import sys

from sony_control import (
    DEFAULT_HOST,
    PowerState,
    Receiver,
    RegistrationRequired,
    SonyError,
)

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="sony-control")
    parser.add_argument("--host", default=os.environ.get("SONY_HOST", DEFAULT_HOST))
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("status")
    subparsers.add_parser("power-on")
    input_parser = subparsers.add_parser("input")
    input_parser.add_argument("name")
    subparsers.add_parser("register")
    args = parser.parse_args(argv)
    standby_source = os.environ.get("SONY_STANDBY_SOURCE", "").strip() or None
    receiver = Receiver(args.host, standby_source=standby_source)

    try:
        if args.command == "register":
            receiver.register()
            print(f"registered: {receiver.device_id}")
        elif args.command == "power-on":
            changed = receiver.power_on()
            print("power: on" + (" (woke receiver)" if changed else ""))
        elif args.command == "input":
            steps = receiver.select_input(args.name)
            print(f"input: {receiver.source()} ({steps} step{'s' if steps != 1 else ''})")
        elif args.command == "status":
            state = receiver.power_state()
            print(f"power: {state.value}")
            if state is not PowerState.ON:
                return 0
            print(f"volume: {receiver.volume()}")
            try:
                status = receiver.cers_status()
                print(f"input: {status.get('source', 'unknown')}")
            except RegistrationRequired:
                print("input: unavailable (CERS registration required)")
        return 0
    except SonyError as error:
        print(f"sony-control: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
